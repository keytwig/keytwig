---
import "@/styles/global.css";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page not found | Keytwig</title>
    <meta name="description" content="This page does not exist. Head back to keytwig, the local encrypted vault for AI agent secrets." />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#141415" />
  </head>
  <body class="relative min-h-screen bg-background text-foreground">
    <SiteHeader currentPath="/404" />
    <main class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
      <p class="code-surface tok-mask inline-block px-1.5 text-sm">‹keytwig:404›</p>
      <h1 class="mt-5 max-w-2xl text-5xl leading-[1.04] font-medium tracking-[-0.04em] text-balance text-white sm:text-6xl">
        This page was never in the vault.
      </h1>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/" class={cn(buttonVariants({ size: "lg" }))}>Back to home</a>
        <a href="/#install" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>Install</a>
      </div>
    </main>
    <SiteFooter />
  </body>
</html>
