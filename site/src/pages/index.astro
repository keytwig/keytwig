---
import "@/styles/global.css";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import FlowDiagram from "@/components/FlowDiagram.astro";
import FeatureBento from "@/components/FeatureBento.astro";
import ComparisonTable from "@/components/ComparisonTable.astro";
import TechDetails from "@/components/TechDetails.astro";
import ThreatModel from "@/components/ThreatModel.astro";
import { HeroKeyBadge } from "@/components/HeroMark";
import { QuickstartTabs } from "@/components/QuickstartTabs";
import { LeakCompare } from "@/components/LeakCompare";
import { AgentPromptBox } from "@/components/AgentPromptBox";
import { DetailsDialog } from "@/components/DetailsDialog";
import { VerifyDialog } from "@/components/VerifyDialog";
import { MEMTWIG_URL, RELEASE_DATE, RELEASE_URL, RELEASES_URL, REPO_URL, SITE_URL, VERSION } from "@/lib/site";

const OG_IMAGE = `${SITE_URL}/og-image.png?v=2`;

const title = "Keytwig: Encrypted secrets for every AI agent";
const description =
  "Keytwig keeps your API keys in one encrypted vault on your machine. AI agents use them to work, without ever seeing them or leaking them into the prompt.";

const steps = [
  { n: "01", img: "/illustrations/step-1-import.webp", title: "Import your .env once", text: "Keytwig finds the keys in your projects and locks them in one encrypted vault." },
  { n: "02", img: "/illustrations/step-2-run.webp", title: "Your agents work as usual", text: "They call your APIs and run your scripts with the real keys." },
  { n: "03", img: "/illustrations/step-3-mask.webp", title: "Secrets never reach the model", text: "Every key is masked before any output goes back to the model." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: "keytwig",
      description,
      inLanguage: "en",
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${SITE_URL}/#software`,
      name: "keytwig",
      url: `${SITE_URL}/`,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Linux, macOS, Windows",
      softwareVersion: VERSION.slice(1),
      datePublished: RELEASE_DATE,
      dateModified: RELEASE_DATE,
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      codeRepository: REPO_URL,
      downloadUrl: RELEASE_URL,
      description,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      isRelatedTo: { "@type": "SoftwareApplication", name: "memtwig", url: MEMTWIG_URL },
      author: {
        "@type": "Person",
        "@id": "https://vittoriocompagno.com/#person",
        name: "Vittorio Compagno",
        url: "https://vittoriocompagno.com",
        sameAs: ["https://github.com/vittoriocompagno", "https://x.com/toriodev", "https://www.linkedin.com/in/vittorio-compagno"],
      },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${SITE_URL}/`} />
    <link rel="alternate" type="text/markdown" href={`${SITE_URL}/llms.txt`} title="LLMs summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#141415" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="keytwig" />
    <meta property="og:url" content={`${SITE_URL}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="keytwig: Encrypted secrets for every AI agent. ‹keytwig:NAME›" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@toriodev" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="relative min-h-screen bg-background text-foreground">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[640px] overflow-hidden" aria-hidden="true">
      <div class="hero-beam absolute -top-40 left-1/2 h-[560px] w-[760px] -translate-x-1/2 rounded-full bg-[radial-gradient(circle_at_center,rgba(235,184,94,0.16)_0%,rgba(88,204,125,0.07)_45%,transparent_72%)] blur-3xl"></div>
    </div>

    <SiteHeader currentPath="/" />

    <main>
      <!-- Hero -->
      <section class="mx-auto max-w-6xl px-5 pt-20 pb-24 sm:px-8 sm:pt-28 sm:pb-32">
        <div class="mx-auto max-w-5xl text-center">
          <h1 class="text-5xl leading-[1.02] font-medium tracking-[-0.045em] text-white sm:text-7xl xl:text-[5.5rem]">
            <span class="lg:whitespace-nowrap">Agents use your <HeroKeyBadge client:load /> keys.</span><br />They never see them.
          </h1>
          <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-zinc-400 sm:text-xl">
            Keytwig keeps your API keys in one encrypted vault on your machine. Claude Code, Cursor and other agents use them to work, without ever seeing them.
          </p>
          <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
            <a href="#install" class={cn(buttonVariants({ variant: "default", size: "lg" }))}>Install {VERSION}</a>
            <a href={REPO_URL} target="_blank" rel="noreferrer" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>GitHub</a>
          </div>
        </div>

        <div class="relative mx-auto mt-10 max-w-3xl sm:mt-12">
          <div class="render-glow pointer-events-none absolute inset-x-[18%] top-[22%] bottom-[18%] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(88,204,125,0.16),rgba(235,184,94,0.06)_45%,transparent_70%)] blur-3xl" aria-hidden="true"></div>
          <img
            src="/illustrations/hero-vault.webp"
            alt=""
            width="1400"
            height="788"
            fetchpriority="high"
            decoding="async"
            class="render render-wide render-float relative mx-auto block h-auto w-full"
          />
        </div>

        <div class="mx-auto mt-2 max-w-4xl sm:mt-4">
          <LeakCompare client:load />
        </div>

        <div id="install" class="mx-auto mt-20 max-w-3xl scroll-mt-24 sm:mt-24">
          <h2 class="text-center text-3xl font-medium tracking-[-0.03em] text-white sm:text-4xl">Install in one line</h2>
          <div class="mt-8">
            <QuickstartTabs client:load />
          </div>
          <a
            href={RELEASES_URL}
            target="_blank"
            rel="noreferrer"
            class="mt-4 inline-flex text-sm font-medium text-zinc-400 transition-colors hover:text-white"
          >
            Prebuilt binaries for Linux, macOS and Windows ↗
          </a>
        </div>
      </section>

      <!-- How it works -->
      <section id="how" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-24 sm:px-8 sm:py-32">
        <h2 class="text-center text-4xl font-medium tracking-[-0.04em] text-white sm:text-6xl">How it works</h2>
        <ol class="mt-14 grid list-none gap-4 p-0 md:grid-cols-3" role="list">
          {
            steps.map((st) => (
              <li class="surface flex min-w-0 flex-col overflow-hidden rounded-[32px]">
                <div class="relative aspect-[3/2]">
                  <img
                    src={st.img}
                    alt=""
                    width="1000"
                    height="667"
                    loading="lazy"
                    decoding="async"
                    class="render absolute inset-0 size-full object-cover"
                  />
                </div>
                <div class="-mt-2 px-8 pb-9 sm:px-9">
                  <span class="inline-flex rounded-full border border-[#ebb85e]/25 bg-[#ebb85e]/10 px-2.5 py-0.5 text-xs font-medium text-[#ebb85e] tabular-nums">{st.n}</span>
                  <h3 class="mt-4 text-2xl leading-tight font-medium tracking-[-0.025em] text-white">{st.title}</h3>
                  <p class="mt-3 text-base leading-relaxed text-zinc-400">{st.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="mt-10 flex justify-center">
          <DetailsDialog client:load label="How it works under the hood" title="Under the hood" size="xl" variant="ghost">
            <FlowDiagram />
          </DetailsDialog>
        </div>
      </section>

      <!-- Benefits -->
      <section id="features" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-24 sm:px-8 sm:py-32">
        <h2 class="mx-auto max-w-3xl text-center text-4xl font-medium tracking-[-0.04em] text-balance text-white sm:text-6xl">
          Built for agents that hold real keys.
        </h2>
        <div class="mt-14">
          <FeatureBento />
        </div>
        <div class="mt-10 flex justify-center">
          <DetailsDialog client:load label="Technical details" title={`Technical details, ${VERSION}`} size="lg" variant="ghost">
            <TechDetails />
          </DetailsDialog>
        </div>
      </section>

      <!-- Comparison -->
      <section id="compare" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-24 sm:px-8 sm:py-32">
        <h2 class="text-center text-4xl font-medium tracking-[-0.04em] text-white sm:text-6xl">Why not .env or op run?</h2>
        <div class="mt-14">
          <ComparisonTable />
        </div>
      </section>

      <!-- Agent prompts -->
      <section id="agents" class="mx-auto max-w-4xl scroll-mt-24 px-5 py-24 sm:px-8 sm:py-32">
        <h2 class="text-center text-4xl font-medium tracking-[-0.04em] text-white sm:text-6xl">Hand the rest to your agent</h2>
        <div class="mt-14">
          <AgentPromptBox client:visible />
        </div>
      </section>

      <!-- Trust and verify -->
      <section id="security" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-24 sm:px-8 sm:py-32">
        <div class="rounded-[40px] border border-white/[0.07] bg-[radial-gradient(ellipse_at_top,rgba(88,204,125,0.08),transparent_60%),#161618] px-6 py-16 text-center sm:px-12 sm:py-24">
          <h2 class="text-4xl font-medium tracking-[-0.04em] text-white sm:text-6xl">Built to be verified.</h2>
          <p class="mx-auto mt-5 max-w-xl text-lg text-zinc-400 sm:text-xl">5 Go dependencies. Local-first. Apache-2.0.</p>
          <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
            <DetailsDialog client:load label="Read the threat model" title="Threat model" size="lg">
              <ThreatModel />
            </DetailsDialog>
            <VerifyDialog client:load />
          </div>
        </div>
      </section>

      <!-- Twig family -->
      <section id="family" class="mx-auto max-w-6xl scroll-mt-24 px-5 pt-8 pb-28 sm:px-8 sm:pb-36">
        <h2 class="text-center text-4xl font-medium tracking-[-0.04em] text-white sm:text-5xl">The Twig family</h2>
        <div class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-2">
          <a href={MEMTWIG_URL} class="group flex items-center gap-5 rounded-[28px] border border-white/[0.07] bg-[#18181b] p-6 transition-colors hover:border-[#58cc7d]/40 sm:p-8">
            <svg viewBox="0 0 32 32" class="size-12 shrink-0" fill="none" aria-hidden="true">
              <rect width="32" height="32" rx="8" fill="#58cc7d"></rect>
              <path d="M16 24.5V8" stroke="#111312" stroke-width="2.6" stroke-linecap="round"></path>
              <path d="M16 18.2L22 12.2" stroke="#111312" stroke-width="2.6" stroke-linecap="round"></path>
              <path d="M16 13.8L10.2 9.4" stroke="#111312" stroke-width="2.6" stroke-linecap="round"></path>
              <circle cx="22.5" cy="11.7" r="2.2" fill="#111312"></circle>
            </svg>
            <div class="min-w-0">
              <p class="text-xl font-medium text-white">memtwig</p>
              <p class="mt-0.5 text-sm text-zinc-400">Memory for your agents ↗</p>
            </div>
          </a>
          <div class="flex items-center gap-5 rounded-[28px] border border-[#ebb85e]/30 bg-[#18181b] p-6 sm:p-8">
            <img src="/favicon.svg" alt="" width="48" height="48" class="size-12 shrink-0" />
            <div class="min-w-0">
              <p class="text-xl font-medium text-white">keytwig</p>
              <p class="mt-0.5 text-sm text-zinc-400">Secrets for your agents · {VERSION}</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
