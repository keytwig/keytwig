---
/*
 * Path of a secret. Above the line, amber: the machine side where values exist (sources, vault,
 * entry point, child process or keytwig_http request, redactor). Below, mint: what leaves keytwig (masked output for the model,
 * metadata for audit.jsonl). Desktop: five columns, then the boundary, then the two outputs under the
 * node that feeds them. Mobile: one column. Rails and dots come from global.css (.rail-*).
 */
type Node = { title: string[]; lines?: string[]; chips?: string[]; mask?: string };

const machine: Node[] = [
  { title: [".env", "keytwig set"], lines: ["import --scan", "stdin, never argv"] },
  { title: ["vault.age"], lines: ["age · X25519", "TPM2 · Keychain · DPAPI", "or scrypt passphrase"] },
  { title: ["keytwig mcp", "keytwig run / http"], lines: ["--agent <harness>", "allow / deny per agent", "PreToolUse hook guard"] },
  { title: ["child process", "or HTTPS request"], lines: ["env vars · 0600 files", "allowed_hosts per secret"] },
  { title: ["stream redactor"], chips: ["raw", "base64", "url", "json", "hex ≥ 8"] },
];

// Outputs, with the machine column (0-based) that feeds each one and its desktop column class.
const outputs: (Node & { from: number; colClass: string })[] = [
  { title: ["audit.jsonl"], lines: ["0600 · metadata", "zero values"], from: 2, colClass: "lg:col-start-3" },
  { title: ["model"], lines: ["stdout + stderr"], mask: "‹keytwig:NAME›", from: 4, colClass: "lg:col-start-5" },
];

const N = 5;
const GAP = 32; // px, lg:gap-x-8
const col = (i: number) => `calc((100% - ${(N - 1) * GAP}px) / ${N} * ${i + 0.5} + ${i * GAP}px)`;
const AMBER = "#ebb85e";
const MINT = "#58cc7d";
---

<div class="relative">
  <!-- Machine side -->
  <ol class="grid list-none gap-y-8 p-0 lg:grid-cols-5 lg:gap-x-8" role="list">
    {
      machine.map((n, i) => (
        <li class="relative min-w-0">
          <div class="h-full rounded-[20px] border border-[#ebb85e]/20 bg-[#18181b] p-5 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)]">
            <span class="mb-4 block size-2 rounded-full bg-[#ebb85e] shadow-[0_0_12px_#ebb85e]" aria-hidden="true" />
            {n.title.map((t) => (
              <p class="code-surface text-[14px] leading-snug break-words text-white">{t}</p>
            ))}
            {n.lines && (
              <ul class="mt-3 space-y-1 text-sm text-zinc-400" role="list">
                {n.lines.map((l) => (
                  <li class="break-words">{l}</li>
                ))}
              </ul>
            )}
            {n.chips && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {n.chips.map((c) => (
                  <span class="code-surface rounded-md border border-white/[0.08] bg-white/[0.03] px-1.5 py-0.5 text-[11px] text-zinc-300">{c}</span>
                ))}
              </div>
            )}
          </div>

          {i < machine.length - 1 && (
            <>
              <div class="rail-v rail-on left-7 top-full h-8 lg:hidden" style={`--c:${AMBER};--delay:${i * 0.4}s`} aria-hidden="true">
                <span class="rail-dot" />
              </div>
              <div class="rail-h rail-on top-11 hidden lg:block" style={`left:100%;width:${GAP}px;--c:${AMBER};--delay:${i * 0.4}s`} aria-hidden="true">
                <span class="rail-dot" />
              </div>
            </>
          )}
        </li>
      ))
    }
  </ol>

  <!-- Trust boundary: the masked output and the audit metadata cross it, values never do -->
  <div class="relative h-28 lg:h-32">
    {/* mobile: one rail down the left edge, through the line */}
    <div class="rail-v rail-on top-0 bottom-0 left-7 lg:hidden" style={`--c:${MINT};--delay:1.7s`} aria-hidden="true">
      <span class="rail-dot" />
    </div>
    {/* desktop: one rail under each node that feeds an output */}
    {
      outputs.map((o, k) => (
        <div class="rail-v rail-on top-0 bottom-0 hidden lg:block" style={`left:${col(o.from)};--c:${MINT};--delay:${1.7 + k * 0.3}s`} aria-hidden="true">
          <span class="rail-dot" />
        </div>
      ))
    }
    <div class="trust-line absolute inset-x-0 top-1/2" aria-hidden="true"></div>
    <p class="absolute top-1/2 left-14 -translate-y-1/2 rounded-full border border-[#58cc7d]/30 bg-[#141415] px-3 py-1 text-xs font-medium text-[#8be3a6] sm:text-sm lg:left-0">
      Trust boundary — secret values never cross this line
    </p>
  </div>

  <!-- Model side -->
  <ul class="grid list-none gap-y-4 p-0 lg:grid-cols-5 lg:gap-x-8" role="list">
    {
      outputs.map((o) => (
        <li class:list={["min-w-0", o.colClass]}>
          <div class="h-full rounded-[20px] border border-[#58cc7d]/25 bg-[#58cc7d]/[0.05] p-5">
            <p class="code-surface text-[14px] text-white">{o.title[0]}</p>
            {o.mask && <p class="code-surface tok-mask mt-2 inline-block px-1 text-xs">{o.mask}</p>}
            {o.lines && (
              <ul class="mt-2 space-y-1 text-sm text-zinc-400" role="list">
                {o.lines.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</div>
