---
// Six benefits of keytwig v0.2.0, each with one true picture of it. Commands, config,
// MCP tools and recorded outputs live in TechDetails.astro, opened from the section's dialog.
// Desktop (3 columns), alternating rhythm: [invisible 1 | domain 2] [local 2 | env 1] [files 1 | agents 2].
const card = "surface relative flex min-w-0 flex-col overflow-hidden rounded-[32px]";
const pad = "p-7 sm:p-10";
const h3 = "text-2xl leading-tight font-medium tracking-[-0.025em] text-white sm:text-3xl";
const sub = "mt-3 max-w-md text-base leading-relaxed text-zinc-400";
const row = "flex items-center justify-between gap-3 rounded-2xl border border-white/[0.05] bg-white/[0.03] px-4 py-3";
const agents = ["Claude Code", "Codex", "Cursor", "Windsurf", "Hermes", "Grok", "Antigravity"];
---

<div class="grid gap-4 lg:grid-cols-3">
  <!-- Keys stay invisible -->
  <article class:list={[card, pad, "justify-between gap-10"]}>
    <div>
      <h3 class={h3}>Keys stay invisible</h3>
      <p class={sub}>Masked the moment they show up in output, even encoded or inside Basic auth.</p>
    </div>
    <div class="code-surface relative grid gap-4 rounded-3xl border border-white/[0.06] bg-[linear-gradient(160deg,rgba(255,255,255,0.05),rgba(255,255,255,0.01))] p-5 text-xs shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] backdrop-blur-sm" aria-hidden="true">
      <span class="w-fit max-w-full break-all text-[#f4a493]/55 line-through decoration-[#f09a7a]/60">sk_test_demo4f9a8b7c6d5e</span>
      <span class="tok-mask w-fit max-w-full px-2 py-1 break-all shadow-[0_0_24px_rgba(88,204,125,0.35),0_0_0_1px_rgba(88,204,125,0.3)]">‹keytwig:STRIPE_SECRET_KEY›</span>
    </div>
  </article>

  <!-- Lock each key to its domain -->
  <article class:list={[card, "lg:col-span-2 lg:min-h-[27rem] lg:justify-center"]}>
    <img
      src="/illustrations/bento-domain.webp"
      alt=""
      width="1000"
      height="667"
      loading="lazy"
      decoding="async"
      class="render relative block aspect-[3/2] h-auto w-full lg:absolute lg:top-1/2 lg:right-[-3%] lg:w-[64%] lg:-translate-y-1/2"
    />
    <div class:list={[pad, "relative -mt-6 flex flex-col justify-between gap-8 lg:mt-0 lg:w-[46%] lg:self-stretch"]}>
      <div>
        <h3 class={h3}>Lock each key to its domain</h3>
        <p class={sub}>Your Stripe key only ever goes to Stripe. API calls run without a shell.</p>
      </div>
      <ul class="grid gap-2.5 text-sm" role="list">
        <li class={row}>
          <span class="code-surface truncate text-zinc-200">api.stripe.com</span>
          <span class="shrink-0 font-medium text-[#8be3a6]">Allowed</span>
        </li>
        <li class={row}>
          <span class="code-surface truncate text-zinc-200">example.com</span>
          <span class="shrink-0 font-medium text-[#f4a493]">Refused</span>
        </li>
      </ul>
    </div>
  </article>

  <!-- Local, encrypted, zero cloud -->
  <article class:list={[card, "lg:col-span-2 lg:min-h-[27rem] lg:justify-center"]}>
    <img
      src="/illustrations/bento-local.webp"
      alt=""
      width="1000"
      height="667"
      loading="lazy"
      decoding="async"
      class="render relative block aspect-[3/2] h-auto w-full lg:absolute lg:top-1/2 lg:left-[-3%] lg:w-[64%] lg:-translate-y-1/2"
    />
    <div class:list={[pad, "relative -mt-6 flex flex-col justify-between gap-8 lg:mt-0 lg:ml-auto lg:w-[46%] lg:self-stretch"]}>
      <div>
        <h3 class={h3}>Local, encrypted, zero cloud</h3>
        <p class={sub}>One vault on your machine, bound to it by default.</p>
      </div>
      <dl class="grid gap-2.5 text-sm">
        {
          ["Account", "Subscription", "Telemetry"].map((t) => (
            <div class={row}>
              <dt class="truncate text-zinc-200">{t}</dt>
              <dd class="shrink-0 font-medium text-[#8be3a6]">None</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </article>

  <!-- Blocks agents from reading .env -->
  <article class:list={[card, pad, "justify-between gap-10"]}>
    <div>
      <svg viewBox="0 0 64 72" class="mb-8 h-[72px] w-16 drop-shadow-[0_0_18px_rgba(88,204,125,0.35)]" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="shield-rim" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#f3d79c" />
            <stop offset="0.45" stop-color="#ebb85e" />
            <stop offset="1" stop-color="#7a5a24" />
          </linearGradient>
          <linearGradient id="shield-face" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#2a2a2f" />
            <stop offset="1" stop-color="#121214" />
          </linearGradient>
        </defs>
        <path d="M32 3 59 13v20c0 17-11.5 30-27 36C16.5 63 5 50 5 33V13L32 3Z" fill="url(#shield-face)" stroke="url(#shield-rim)" stroke-width="2.5" stroke-linejoin="round" />
        <path d="M32 11 51 18v15c0 12.5-8 22.5-19 27-11-4.5-19-14.5-19-27V18l19-7Z" stroke="#58cc7d" stroke-opacity="0.35" stroke-width="1" />
        <circle cx="32" cy="30" r="6" fill="#58cc7d" fill-opacity="0.9" />
        <path d="M29.5 34h5l1.5 11h-8l1.5-11Z" fill="#58cc7d" fill-opacity="0.9" />
      </svg>
      <h3 class={h3}>Blocks agents from reading .env</h3>
      <p class={sub}>Claude Code and Cursor are stopped before they open a secret file or dump the environment.</p>
    </div>
    <ul class="grid gap-2.5 text-sm" role="list">
      {
        [".env", "printenv"].map((t) => (
          <li class={row}>
            <span class="code-surface truncate text-zinc-200">{t}</span>
            <span class="shrink-0 font-medium text-[#f4a493]">Blocked</span>
          </li>
        ))
      }
    </ul>
  </article>

  <!-- Secret files never linger on disk -->
  <article class:list={[card, pad, "justify-between gap-10"]}>
    <div>
      <h3 class={h3}>Secret files never linger on disk</h3>
      <p class={sub}>Service-account JSON and PEM keys exist for one run, then they are wiped.</p>
    </div>
    <ol class="grid gap-2.5 text-sm" role="list">
      <li class={row}>
        <span class="code-surface truncate text-[#ebb85e]">sa.json</span>
        <span class="shrink-0 text-zinc-400">Encrypted</span>
      </li>
      <li class={row}>
        <span class="truncate text-zinc-200">During the run</span>
        <span class="shrink-0 text-zinc-400">Mounted</span>
      </li>
      <li class={row}>
        <span class="truncate text-zinc-200">After</span>
        <span class="shrink-0 font-medium text-[#8be3a6]">Wiped</span>
      </li>
    </ol>
  </article>

  <!-- One setup, every coding agent -->
  <article class:list={[card, pad, "justify-between gap-10 lg:col-span-2"]}>
    <div>
      <h3 class={h3}>One setup, every coding agent</h3>
      <p class={sub}>One command connects them all.</p>
    </div>
    <div class="grid gap-6">
      <ul class="flex flex-wrap gap-2.5" role="list">
        {
          agents.map((a) => (
            <li class="inline-flex items-center gap-2.5 rounded-full border border-white/[0.08] bg-[linear-gradient(180deg,rgba(255,255,255,0.06),rgba(255,255,255,0.02))] py-2 pr-4 pl-3 text-sm font-medium text-zinc-100 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] sm:text-base">
              <span class="size-2 rounded-full bg-[#58cc7d] shadow-[0_0_8px_#58cc7d]" aria-hidden="true" />
              {a}
            </li>
          ))
        }
      </ul>
      <p class="code-surface w-fit rounded-xl border border-white/[0.06] bg-[#111113] px-4 py-2.5 text-sm text-zinc-300">
        <span class="text-zinc-500">$ </span><span class="tok-cmd">keytwig</span> install all
      </p>
    </div>
  </article>
</div>
