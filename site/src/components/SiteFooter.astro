---
import {
  CONTACT_EMAIL,
  LICENSE_URL,
  MEMTWIG_URL,
  README_URL,
  REGISTRY_URL,
  RELEASES_URL,
  REPO_URL,
  SECURITY_URL,
} from "@/lib/site";
---

<footer class="border-t border-white/[0.08] bg-[#111112] pt-20 pb-12">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="/" class="inline-flex items-center gap-2.5 text-base font-semibold tracking-tight text-white">
          <img src="/favicon.svg" alt="" width="24" height="24" class="rounded-lg" />
          <span>keytwig</span>
        </a>
        <p class="mt-6 max-w-md text-2xl leading-[1.28] font-normal tracking-[-0.025em] text-zinc-100 sm:text-[1.7rem]">
          One local encrypted vault. Agents run with the keys, the model gets masked output.
        </p>
        <a
          href="/#install"
          class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-[#ebb85e] transition-colors hover:text-[#f3cb7f]"
        >
          Install Keytwig →
        </a>
      </div>

      <div class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-3 lg:col-span-7">
        <div>
          <h3 class="text-sm font-medium text-white">Product</h3>
          <ul class="mt-4 space-y-2.5 text-zinc-400">
            <li><a href="/#how" class="transition-colors hover:text-white">How it works</a></li>
            <li><a href="/#features" class="transition-colors hover:text-white">Features</a></li>
            <li><a href="/#compare" class="transition-colors hover:text-white">Compare</a></li>
            <li><a href="/#security" class="transition-colors hover:text-white">Threat model</a></li>
            <li><a href="/#install" class="transition-colors hover:text-white">Install</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-sm font-medium text-white">Project</h3>
          <ul class="mt-4 space-y-2.5 text-zinc-400">
            <li><a href={REPO_URL} target="_blank" rel="noreferrer" class="transition-colors hover:text-white">GitHub</a></li>
            <li><a href={RELEASES_URL} target="_blank" rel="noreferrer" class="transition-colors hover:text-white">Releases</a></li>
            <li><a href={REGISTRY_URL} target="_blank" rel="noreferrer" class="transition-colors hover:text-white">MCP Registry</a></li>
            <li><a href={README_URL} target="_blank" rel="noreferrer" class="transition-colors hover:text-white">README</a></li>
            <li><a href={SECURITY_URL} target="_blank" rel="noreferrer" class="transition-colors hover:text-white">SECURITY.md</a></li>
            <li><a href="/llms.txt" class="transition-colors hover:text-white">llms.txt</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-sm font-medium text-white">Twig family</h3>
          <ul class="mt-4 space-y-2.5 text-zinc-400">
            <li><a href={MEMTWIG_URL} class="transition-colors hover:text-white">memtwig</a></li>
            <li><a href="/" class="transition-colors hover:text-white">keytwig</a></li>
            <li><a href={`mailto:${CONTACT_EMAIL}`} class="break-all transition-colors hover:text-white">{CONTACT_EMAIL}</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-white/[0.07] pt-8 text-xs text-muted-foreground sm:flex-row sm:items-center">
      <span>© 2026 <a href="https://vittoriocompagno.com" rel="author" class="transition-colors hover:text-white">Vittorio Compagno</a> · <a href={LICENSE_URL} target="_blank" rel="noreferrer" class="transition-colors hover:text-white">Apache 2.0</a></span>
      <span class="inline-flex items-center gap-2 text-zinc-300">
        <span class="size-2 rounded-full bg-[#58cc7d]" aria-hidden="true"></span>
        <span>Zero telemetry · no network calls outside keytwig http</span>
      </span>
    </div>
  </div>
</footer>
