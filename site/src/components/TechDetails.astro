---
// Everything the bento cards leave out, for whoever wants to dig: real commands, config and
// outputs recorded with keytwig v0.2.0 in a sandbox with a dummy key, plus the five MCP tools.
const h3 = "text-base font-medium text-white sm:text-lg";
const pre = "code-surface m-0 mt-3 overflow-x-auto rounded-2xl border border-white/[0.06] bg-[#111113] p-4 text-xs leading-[1.8] whitespace-pre sm:text-[13px]";

const tools = [
  ["keytwig_http", "HTTP request with {{NAME}} placeholders, no shell, limited to the secret's allowed_hosts, response masked"],
  ["keytwig_run", "shell command with secrets injected (keys, file_keys or project: true), output masked"],
  ["keytwig_list", "names, aliases, kind, allowed_hosts, expiry, and the env vars the current project gets"],
  ["keytwig_import", "moves a .env into the vault without values passing through the model"],
  ["keytwig_status", "vault and identity status"],
];
const encodings = ["raw", "base64", "url", "json", "hex ≥ 8 chars", "Basic auth from *_USER + *_PASS"];
const backends = [
  ["Linux", "TPM2 via systemd-creds"],
  ["macOS", "login Keychain"],
  ["Windows", "DPAPI, Credential Manager"],
  ["anywhere", "--passphrase (scrypt) + unlock --ttl"],
];
---

<div class="grid gap-10 [&>*]:min-w-0">
  <section>
    <h3 class={h3}>MCP tools</h3>
    <p class="mt-1 text-sm text-zinc-400">None returns a value. There is no get or set tool.</p>
    <ul class="mt-3 divide-y divide-white/[0.06]" role="list">
      {
        tools.map(([t, d]) => (
          <li class="grid gap-1 py-3 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-4">
            <span class="code-surface text-sm text-[#ebb85e]">{t}</span>
            <span class="text-sm text-zinc-400">{d}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h3 class={h3}>Masking</h3>
    <p class="mt-1 text-sm text-zinc-400">Every stored value of 6+ characters, in stdout and stderr, across write boundaries.</p>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {encodings.map((e) => <span class="code-surface rounded-md bg-white/[0.05] px-2 py-0.5 text-xs text-zinc-300">{e}</span>)}
      <span class="code-surface tok-mask px-2 py-0.5 text-xs">→ ‹keytwig:NAME›</span>
    </div>
  </section>

  <section>
    <h3 class={h3}>Per-secret hosts and per-agent policies</h3>
    <pre class={pre}><code><span class="tok-com"># ~/.config/keytwig/config.toml</span>
<span class="tok-sec">[secrets.STRIPE_SECRET_KEY]</span>
<span class="tok-key">allowed_hosts</span> <span class="tok-punct">=</span> <span class="tok-punct">[</span><span class="tok-str">"api.stripe.com"</span><span class="tok-punct">]</span>   <span class="tok-com"># empty denies keytwig_http</span>
<span class="tok-key">expires</span> <span class="tok-punct">=</span> <span class="tok-str">"2026-12-31"</span>

<span class="tok-sec">[agents.hermes]</span>
<span class="tok-key">allow</span> <span class="tok-punct">=</span> <span class="tok-punct">[</span><span class="tok-str">"ACME_*"</span><span class="tok-punct">,</span> <span class="tok-str">"STRIPE_*"</span><span class="tok-punct">]</span>
<span class="tok-key">deny</span>  <span class="tok-punct">=</span> <span class="tok-punct">[</span><span class="tok-str">"*_PROD"</span><span class="tok-punct">]</span>        <span class="tok-com"># deny wins, aliases cannot dodge it</span></code></pre>
  </section>

  <section>
    <h3 class={h3}>Shell-free HTTP</h3>
    <pre class={pre}><code><span class="text-zinc-500">$ </span><span class="tok-cmd">keytwig</span> <span class="text-zinc-200">http GET https://httpbin.org/bearer \</span>
  <span class="tok-flag">-H</span> <span class="text-zinc-200">'Authorization: Bearer {"{{STRIPE_SECRET_KEY}}"}'</span>
<span class="text-zinc-300">HTTP 200</span>
<span class="text-zinc-300">{"{"}</span>
<span class="text-zinc-300">  "authenticated": true,</span>
<span class="text-zinc-300">  "token": "</span><span class="tok-mask px-0.5">‹keytwig:STRIPE_SECRET_KEY›</span><span class="text-zinc-300">"</span>
<span class="text-zinc-300">{"}"}</span>

<span class="text-zinc-500">$ </span><span class="tok-cmd">keytwig</span> <span class="text-zinc-200">http GET https://example.com/ \</span>
  <span class="tok-flag">-H</span> <span class="text-zinc-200">'Authorization: Bearer {"{{STRIPE_SECRET_KEY}}"}'</span>
<span class="tok-leak px-0.5">keytwig: secret STRIPE_SECRET_KEY is not allowed for host "example.com"</span></code></pre>
    <p class="mt-3 text-sm text-zinc-400">HTTPS only (except localhost). Cross-host redirects are refused when secrets are injected.</p>
  </section>

  <section>
    <h3 class={h3}>PreToolUse guard</h3>
    <pre class={pre}><code><span class="tok-com"># keytwig hook claude, on three tool calls</span>
<span class="text-zinc-500">Read</span> <span class="text-zinc-200">~/code/shop/.env</span>   <span class="tok-leak px-0.5">deny</span>
<span class="text-zinc-500">Bash</span> <span class="text-zinc-200">printenv</span>           <span class="tok-leak px-0.5">deny</span>
<span class="text-zinc-500">Bash</span> <span class="text-zinc-200">ls</span>                 <span class="tok-mask px-0.5">allow</span></code></pre>
    <p class="mt-3 text-sm text-zinc-400">Blocks .env, vault.age, identity.txt, known credential files and raw env dumps. Installed for Claude Code by keytwig install (--no-hooks to skip); keytwig hook cursor for Cursor.</p>
  </section>

  <section>
    <h3 class={h3}>File secrets</h3>
    <pre class={pre}><code><span class="text-zinc-500">$ </span><span class="tok-cmd">keytwig</span> <span class="text-zinc-200">set GCP_SA</span> <span class="tok-flag">--file</span> <span class="text-zinc-200">sa.json</span>
<span class="text-zinc-400">GCP_SA added [file]</span>
<span class="text-zinc-500">$ </span><span class="tok-cmd">keytwig</span> <span class="text-zinc-200">run</span> <span class="tok-flag">--file-key</span> <span class="text-zinc-200">SA=GCP_SA -- ./deploy.sh</span>
<span class="tok-com"># $SA = $XDG_RUNTIME_DIR/keytwig-mount-…/f0/sa.json</span></code></pre>
    <p class="mt-3 text-sm text-zinc-400">Up to 1 MiB. Written 0600 in a 0700 directory for one command, then overwritten with zeros and deleted.</p>
  </section>

  <section>
    <h3 class={h3}>Identity at rest</h3>
    <dl class="mt-3 divide-y divide-white/[0.06]">
      {
        backends.map(([os, how]) => (
          <div class="flex items-baseline justify-between gap-4 py-2.5 text-sm">
            <dt class="text-zinc-400">{os}</dt>
            <dd class="code-surface text-right text-xs text-zinc-200">{how}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section>
    <h3 class={h3}>Setup, projects and audit</h3>
    <pre class={pre}><code><span class="tok-cmd">keytwig</span> <span class="text-zinc-200">install all</span>          <span class="tok-com"># MCP in every harness, hook in Claude Code</span>
<span class="tok-cmd">keytwig</span> <span class="text-zinc-200">doctor</span>               <span class="tok-com"># permissions, expiry, harnesses</span>
<span class="tok-cmd">keytwig</span> <span class="text-zinc-200">scan</span>                 <span class="tok-com"># names and paths only</span>
<span class="tok-cmd">keytwig</span> <span class="text-zinc-200">import</span> <span class="tok-flag">--scan</span>
<span class="tok-cmd">keytwig</span> <span class="text-zinc-200">rewrite</span> <span class="tok-flag">--scan --apply</span>  <span class="tok-com"># .env values become keytwig://NAME</span>
<span class="tok-cmd">keytwig</span> <span class="text-zinc-200">run</span> <span class="tok-flag">-p</span> <span class="text-zinc-200">-- npm run dev</span>
<span class="tok-cmd">keytwig</span> <span class="text-zinc-200">log</span> <span class="tok-flag">--agent</span> <span class="text-zinc-200">hermes</span>   <span class="tok-com"># audit.jsonl, metadata only</span></code></pre>
  </section>
</div>
